@model Module
@{
    ViewData["Title"] = "Supprimer le module";
}

<h1 class="mb-4 text-danger"><i class="bi bi-trash"></i> Supprimer le module</h1>

<div class="alert alert-warning">
    Êtes-vous sûr de vouloir supprimer ce module ? Tous ses cours, exercices et examens seront également supprimés.
</div>

<dl class="row">
    <dt class="col-sm-2">Titre</dt>
    <dd class="col-sm-10">@Model.Titre</dd>
    <dt class="col-sm-2">Formation</dt>
    <dd class="col-sm-10">@Model.Formation?.Titre</dd>
    <dt class="col-sm-2">Contenus liés</dt>
    <dd class="col-sm-10">@Model.Modalites.Count</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirmer la suppression</button>
    <a asp-action="Index" asp-route-formationId="@Model.FormationId" class="btn btn-outline-secondary">Annuler</a>
</form>
