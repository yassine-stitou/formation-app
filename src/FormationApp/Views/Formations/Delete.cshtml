@model Formation
@{
    ViewData["Title"] = "Supprimer la formation";
}

<h1 class="mb-4 text-danger"><i class="bi bi-trash"></i> Supprimer la formation</h1>

<div class="alert alert-warning">
    Êtes-vous sûr de vouloir supprimer cette formation ? Tous ses modules, modalités et inscriptions seront également supprimés. Cette action est irréversible.
</div>

<dl class="row">
    <dt class="col-sm-2">Titre</dt>
    <dd class="col-sm-10">@Model.Titre</dd>
    <dt class="col-sm-2">Catégorie</dt>
    <dd class="col-sm-10">@Model.Categorie?.Nom</dd>
    <dt class="col-sm-2">Formateur</dt>
    <dd class="col-sm-10">@Model.Formateur?.NomComplet</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirmer la suppression</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
</form>
