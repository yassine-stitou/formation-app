@model Modalite
@{
    ViewData["Title"] = Model.Titre;
}

<h1 class="mb-2"><i class="bi bi-patch-question"></i> @Model.Titre</h1>
<p class="text-muted mb-4">Score minimum de réussite : <strong>@Model.ScoreMinReussite%</strong> — @Model.Questions.Count question(s)</p>

<form asp-controller="Apprenant" asp-action="SoumettreExamen" method="post">
    <input type="hidden" name="modaliteId" value="@Model.Id" />

    @{ int index = 0; }
    @foreach (var q in Model.Questions.OrderBy(x => x.Ordre))
    {
        index++;
        <div class="card mb-3">
            <div class="card-body">
                <p class="fw-semibold">@index. @q.Enonce</p>
                @foreach (var o in q.Options)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="reponses[@q.Id]" id="opt@(o.Id)" value="@o.Id" required>
                        <label class="form-check-label" for="opt@(o.Id)">@o.Texte</label>
                    </div>
                }
            </div>
        </div>
    }

    @if (!Model.Questions.Any())
    {
        <p class="text-muted">Ce quiz ne contient pas encore de question.</p>
    }
    else
    {
        <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> Soumettre mes réponses</button>
    }
</form>
