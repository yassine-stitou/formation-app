@model Categorie
@{
    ViewData["Title"] = "Supprimer la catégorie";
}

<h1 class="mb-4 text-danger"><i class="bi bi-trash"></i> Supprimer la catégorie</h1>

<div class="alert alert-warning">
    Êtes-vous sûr de vouloir supprimer cette catégorie ? Cette action est irréversible.
</div>

<dl class="row">
    <dt class="col-sm-2">Nom</dt>
    <dd class="col-sm-10">@Model.Nom</dd>
    <dt class="col-sm-2">Description</dt>
    <dd class="col-sm-10">@Model.Description</dd>
    <dt class="col-sm-2">Formations liées</dt>
    <dd class="col-sm-10">@Model.Formations.Count</dd>
</dl>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Confirmer la suppression</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
</form>
