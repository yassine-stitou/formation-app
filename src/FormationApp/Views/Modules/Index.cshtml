@model Formation
@{
    ViewData["Title"] = "Modules - " + Model.Titre;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Formations" asp-action="Index">Formations</a></li>
        <li class="breadcrumb-item active">@Model.Titre</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-collection"></i> Modules de "@Model.Titre"</h1>
    <a asp-action="Create" asp-route-formationId="@Model.Id" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nouveau module</a>
</div>

<div class="accordion" id="accordionModules">
    @foreach (var module in Model.Modules)
    {
        <div class="accordion-item mb-2">
            <h2 class="accordion-header d-flex align-items-center">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#mod@(module.Id)">
                    <strong class="me-2">Module @module.Ordre :</strong> @module.Titre
                    <span class="badge bg-secondary ms-2">@module.Modalites.Count élément(s)</span>
                </button>
            </h2>
            <div id="mod@(module.Id)" class="accordion-collapse collapse" data-bs-parent="#accordionModules">
                <div class="accordion-body">
                    <p class="text-muted">@module.Description</p>

                    <div class="d-flex gap-2 mb-3">
                        <a asp-action="Edit" asp-route-id="@module.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i> Modifier le module</a>
                        <a asp-action="Delete" asp-route-id="@module.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Supprimer</a>
                        <a asp-controller="Modalites" asp-action="Create" asp-route-moduleId="@module.Id" class="btn btn-sm btn-primary"><i class="bi bi-plus-circle"></i> Ajouter cours/exercice/examen</a>
                    </div>

                    <ul class="list-group">
                        @foreach (var m in module.Modalites.OrderBy(x => x.Ordre))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>
                                    <i class="bi @(m.Type == TypeModalite.Cours ? "bi-play-circle text-primary" : m.Type == TypeModalite.Exercice ? "bi-pencil-square text-warning" : "bi-patch-question text-success")"></i>
                                    <strong>@m.Titre</strong>
                                    <span class="badge bg-light text-dark ms-1">@m.Type</span>
                                </span>
                                <span>
                                    @if (m.Type == TypeModalite.Examen)
                                    {
                                        <a asp-controller="Modalites" asp-action="Questions" asp-route-modaliteId="@m.Id" class="btn btn-sm btn-outline-success"><i class="bi bi-list-check"></i> Questions</a>
                                    }
                                    <a asp-controller="Modalites" asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                                    <a asp-controller="Modalites" asp-action="Delete" asp-route-id="@m.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                                </span>
                            </li>
                        }
                        @if (!module.Modalites.Any())
                        {
                            <li class="list-group-item text-muted">Aucun contenu pour ce module pour l'instant.</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    }
    @if (!Model.Modules.Any())
    {
        <p class="text-muted text-center py-5">Aucun module. Commencez par en créer un.</p>
    }
</div>
