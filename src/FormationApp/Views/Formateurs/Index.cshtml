@model List<Formateur>
@{
    ViewData["Title"] = "Formateurs";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-person-badge"></i> Formateurs</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nouveau formateur</a>
</div>

<div class="row g-3">
    @foreach (var f in Model)
    {
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <img src="@(string.IsNullOrEmpty(f.PhotoUrl) ? "https://placehold.co/64x64?text=" + f.Prenom[0] : f.PhotoUrl)"
                             class="rounded-circle me-3" width="56" height="56" style="object-fit:cover;" alt="@f.NomComplet">
                        <div>
                            <h5 class="card-title mb-0">@f.NomComplet</h5>
                            <small class="text-muted">@f.Specialite</small>
                        </div>
                    </div>
                    <p class="card-text small text-muted">@f.Email</p>
                    <span class="badge bg-secondary">@f.Formations.Count formation(s)</span>
                </div>
                <div class="card-footer bg-white d-flex justify-content-end gap-1">
                    <a asp-action="Details" asp-route-id="@f.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a>
                    <a asp-action="Edit" asp-route-id="@f.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a>
                    <a asp-action="Delete" asp-route-id="@f.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <p class="text-muted text-center py-4">Aucun formateur pour le moment.</p>
    }
</div>
