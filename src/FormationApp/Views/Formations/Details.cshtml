@model Formation
@{
    ViewData["Title"] = Model.Titre;
    var estInscrit = ViewBag.EstInscrit as bool? ?? false;
}

<div class="row">
    <div class="col-md-8">
        <span class="badge bg-secondary mb-2">@Model.Categorie?.Nom</span>
        <h1>@Model.Titre</h1>
        <p class="text-muted">
            <i class="bi bi-person"></i> Formateur : <strong>@Model.Formateur?.NomComplet</strong>
            @if (Model.DateDebut.HasValue)
            {
                <span class="ms-3"><i class="bi bi-calendar-event"></i> Du @Model.DateDebut?.ToString("dd/MM/yyyy") au @Model.DateFin?.ToString("dd/MM/yyyy")</span>
            }
        </p>
        <p>@Model.Description</p>

        <h4 class="mt-4">Programme de la formation</h4>
        <div class="accordion" id="accordionModules">
            @foreach (var module in Model.Modules)
            {
                <div class="accordion-item">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#module@(module.Id)">
                            <strong>Module @module.Ordre :</strong>&nbsp;@module.Titre
                        </button>
                    </h2>
                    <div id="module@(module.Id)" class="accordion-collapse collapse" data-bs-parent="#accordionModules">
                        <div class="accordion-body">
                            <p class="text-muted">@module.Description</p>
                            <ul class="list-group list-group-flush">
                                @foreach (var m in module.Modalites)
                                {
                                    <li class="list-group-item d-flex justify-content-between">
                                        <span>
                                            <i class="bi @(m.Type == TypeModalite.Cours ? "bi-play-circle" : m.Type == TypeModalite.Exercice ? "bi-pencil-square" : "bi-patch-question")"></i>
                                            @m.Titre
                                        </span>
                                        <span class="badge bg-light text-dark">@m.Type &middot; @m.DureeMinutes min</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
            @if (!Model.Modules.Any())
            {
                <p class="text-muted">Le programme détaillé sera bientôt disponible.</p>
            }
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <p><i class="bi bi-people"></i> @Model.NombreInscrits / @Model.PlacesDisponibles places</p>

                @if (User.IsInRole(Roles.Admin))
                {
                    <form asp-controller="Formations" asp-action="ChangerStatut" method="post" class="mb-2">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <label class="form-label small">Statut</label>
                        <select name="statut" class="form-select mb-2" onchange="this.form.submit()">
                            @foreach (StatutFormation s in Enum.GetValues(typeof(StatutFormation)))
                            {
                                <option value="@s" selected="@(s == Model.Statut)">@s</option>
                            }
                        </select>
                    </form>
                    <a asp-controller="Modules" asp-action="Index" asp-route-formationId="@Model.Id" class="btn btn-outline-secondary w-100 mb-2">
                        <i class="bi bi-collection"></i> Gérer les modules
                    </a>
                }
                else if (User.Identity?.IsAuthenticated == true)
                {
                    @if (estInscrit)
                    {
                        <a asp-controller="Apprenant" asp-action="Player" asp-route-formationId="@Model.Id" class="btn btn-success w-100">
                            <i class="bi bi-play-circle"></i> Continuer la formation
                        </a>
                    }
                    else if (Model.NombreInscrits >= Model.PlacesDisponibles)
                    {
                        <button class="btn btn-secondary w-100" disabled>Formation complète</button>
                    }
                    else
                    {
                        <form asp-controller="Apprenant" asp-action="Inscrire" method="post">
                            <input type="hidden" name="formationId" value="@Model.Id" />
                            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check-circle"></i> S'inscrire</button>
                        </form>
                    }
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Details", "Formations", new { id = Model.Id })" class="btn btn-primary w-100">
                        Connectez-vous pour vous inscrire
                    </a>
                }
            </div>
        </div>
    </div>
</div>
