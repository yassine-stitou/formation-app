@{
    ViewData["Title"] = "Tableau de bord";
}

<h1 class="mb-4"><i class="bi bi-speedometer2"></i> Tableau de bord administrateur</h1>

<div class="row g-3 mb-4">
    <div class="col-md-2 col-6">
        <div class="card text-center shadow-sm border-primary">
            <div class="card-body">
                <div class="fs-3 fw-bold text-primary">@ViewBag.NbFormations</div>
                <div class="text-muted small">Formations</div>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="card text-center shadow-sm border-success">
            <div class="card-body">
                <div class="fs-3 fw-bold text-success">@ViewBag.NbFormationsPubliees</div>
                <div class="text-muted small">Publiées</div>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="card text-center shadow-sm border-info">
            <div class="card-body">
                <div class="fs-3 fw-bold text-info">@ViewBag.NbFormateurs</div>
                <div class="text-muted small">Formateurs</div>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="card text-center shadow-sm border-warning">
            <div class="card-body">
                <div class="fs-3 fw-bold text-warning">@ViewBag.NbCategories</div>
                <div class="text-muted small">Catégories</div>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="card text-center shadow-sm border-secondary">
            <div class="card-body">
                <div class="fs-3 fw-bold">@ViewBag.NbApprenants</div>
                <div class="text-muted small">Utilisateurs</div>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="card text-center shadow-sm border-dark">
            <div class="card-body">
                <div class="fs-3 fw-bold">@ViewBag.NbInscriptions</div>
                <div class="text-muted small">Inscriptions</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <a asp-controller="Categories" asp-action="Index" class="btn btn-outline-primary w-100 py-3">
            <i class="bi bi-tags"></i><br />Gérer les catégories
        </a>
    </div>
    <div class="col-md-3">
        <a asp-controller="Formateurs" asp-action="Index" class="btn btn-outline-primary w-100 py-3">
            <i class="bi bi-person-badge"></i><br />Gérer les formateurs
        </a>
    </div>
    <div class="col-md-3">
        <a asp-controller="Formations" asp-action="Create" class="btn btn-outline-success w-100 py-3">
            <i class="bi bi-plus-circle"></i><br />Créer une formation
        </a>
    </div>
    <div class="col-md-3">
        <a asp-controller="Inscriptions" asp-action="Index" class="btn btn-outline-primary w-100 py-3">
            <i class="bi bi-people"></i><br />Gérer les inscriptions
        </a>
    </div>
</div>

<h2 class="h5">Dernières inscriptions</h2>
<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Apprenant</th>
                <th>Formation</th>
                <th>Date</th>
                <th>Statut</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in ViewBag.DernieresInscriptions as List<Inscription> ?? new())
            {
                <tr>
                    <td>@i.ApplicationUser?.NomComplet</td>
                    <td>@i.Formation?.Titre</td>
                    <td>@i.DateInscription.ToString("dd/MM/yyyy")</td>
                    <td><span class="badge bg-secondary">@i.Statut</span></td>
                </tr>
            }
        </tbody>
    </table>
</div>
