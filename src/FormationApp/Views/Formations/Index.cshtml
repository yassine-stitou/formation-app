@model List<Formation>
@{
    ViewData["Title"] = "Catalogue des formations";
    var categories = ViewBag.Categories as List<Categorie> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-journal-bookmark"></i> Formations</h1>
    @if (User.IsInRole(Roles.Admin))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Nouvelle formation</a>
    }
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-4">
        <input type="text" name="recherche" value="@ViewBag.Recherche" class="form-control" placeholder="Rechercher une formation..." />
    </div>
    <div class="col-md-4">
        <select name="categorieId" class="form-select">
            <option value="">Toutes les catégories</option>
            @foreach (var c in categories)
            {
                <option value="@c.Id" selected="@(ViewBag.CategorieId == c.Id)">@c.Nom</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> Filtrer</button>
    </div>
</form>

<div class="row g-4">
    @foreach (var f in Model)
    {
        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <img src="@(string.IsNullOrEmpty(f.ImageUrl) ? "https://placehold.co/600x300?text=Formation" : f.ImageUrl)"
                     class="card-img-top" style="height:160px;object-fit:cover;" alt="@f.Titre">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="badge bg-secondary">@f.Categorie?.Nom</span>
                        @if (User.IsInRole(Roles.Admin))
                        {
                            <span class="badge @(f.Statut == StatutFormation.Publiee ? "bg-success" : f.Statut == StatutFormation.Brouillon ? "bg-warning text-dark" : "bg-dark")">@f.Statut</span>
                        }
                    </div>
                    <h5 class="card-title">@f.Titre</h5>
                    <p class="card-text small text-muted flex-grow-1">
                        @(f.Description?.Length > 90 ? f.Description[..90] + "…" : f.Description)
                    </p>
                    <p class="small text-muted mb-2">
                        <i class="bi bi-person"></i> @f.Formateur?.NomComplet &middot;
                        <i class="bi bi-people"></i> @f.NombreInscrits / @f.PlacesDisponibles places
                    </p>
                    <div class="d-flex gap-1">
                        <a asp-action="Details" asp-route-id="@f.Id" class="btn btn-outline-primary flex-grow-1">Voir</a>
                        @if (User.IsInRole(Roles.Admin))
                        {
                            <a asp-controller="Modules" asp-action="Index" asp-route-formationId="@f.Id" class="btn btn-outline-secondary" title="Modules"><i class="bi bi-collection"></i></a>
                            <a asp-action="Edit" asp-route-id="@f.Id" class="btn btn-outline-secondary" title="Modifier"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@f.Id" class="btn btn-outline-danger" title="Supprimer"><i class="bi bi-trash"></i></a>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <p class="text-muted text-center py-5">Aucune formation ne correspond à votre recherche.</p>
    }
</div>
