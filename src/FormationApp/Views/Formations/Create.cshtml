@model Formation
@{
    ViewData["Title"] = "Nouvelle formation";
}

<h1 class="mb-4"><i class="bi bi-plus-circle"></i> Nouvelle formation</h1>

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Titre" class="form-label"></label>
                <input asp-for="Titre" class="form-control" />
                <span asp-validation-for="Titre" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="CategorieId" class="form-label"></label>
                    <select asp-for="CategorieId" asp-items="ViewBag.CategorieId as SelectList" class="form-select">
                        <option value="">-- Sélectionner --</option>
                    </select>
                    <span asp-validation-for="CategorieId" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="FormateurId" class="form-label"></label>
                    <select asp-for="FormateurId" asp-items="ViewBag.FormateurId as SelectList" class="form-select">
                        <option value="">-- Sélectionner --</option>
                    </select>
                    <span asp-validation-for="FormateurId" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="DateDebut" class="form-label"></label>
                    <input asp-for="DateDebut" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="DateFin" class="form-label"></label>
                    <input asp-for="DateFin" class="form-control" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="PlacesDisponibles" class="form-label"></label>
                    <input asp-for="PlacesDisponibles" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ImageUrl" class="form-label"></label>
                    <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Statut" class="form-label"></label>
                <select asp-for="Statut" class="form-select">
                    @foreach (StatutFormation s in Enum.GetValues(typeof(StatutFormation)))
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Créer la formation</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
